# .gitignore — AI Daily Brief

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
*.env.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
*.whl

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Preview files (generated locally) ────────────────────────────────────────
data/preview_*.html

# NOTE: data/sent_stories.json is intentionally NOT gitignored.
# It is committed back to the repo by the GitHub Actions workflow
# so the history persists across runs.
