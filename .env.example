# ─── Groq API (OpenAI OSS Models) ─────────────────────────────────────────────
# Get your free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenAI GPT-OSS model on Groq: openai/gpt-oss-20b or openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-20b

# ─── Email / Gmail SMTP ───────────────────────────────────────────────────────
# Your Gmail address (sender)
EMAIL_SENDER=your_email@gmail.com

# Gmail App Password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on your account
EMAIL_PASSWORD=your_16_char_app_password

# Recipient address (can be same as sender, or a different address)
EMAIL_RECIPIENT=your_recipient@gmail.com

# ─── Optional Overrides ───────────────────────────────────────────────────────
# Override the feeds config path (default: config/feeds.yaml)
# FEEDS_CONFIG_PATH=config/feeds.yaml

# Override history file path (default: data/sent_stories.json)
# HISTORY_FILE_PATH=data/sent_stories.json

# Number of days to keep history (default: 7)
# HISTORY_RETENTION_DAYS=7

# Max stories to select per edition (default: 12)
# MAX_STORIES=12

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO
